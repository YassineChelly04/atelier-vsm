{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atelier VSM",
  "version": "0.1.0",
  "identifier": "com.ateliervsm.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atelier VSM",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Cartographie VSM avec calculs Lean en direct",
    "longDescription": "Éditeur de Value Stream Mapping : symboles VSM, glisser-déposer, guides et équidistances, takt, lead time, PCE, ligne de temps automatique, comparaison état actuel / état futur.",
    "copyright": "© 2026 Atelier VSM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
